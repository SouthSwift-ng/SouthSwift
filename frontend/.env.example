# Must match vercel.json rewrite source + backend SHARE_PATH_PREFIX.
REACT_APP_SHARE_PATH_PREFIX=/s

# ─── VERCEL SERVER ENV (NOT REACT_APP_* — dashboard only, never browsers) ──
# BACKEND_ORIGIN=https://southswift.onrender.com
