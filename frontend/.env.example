REACT_APP_API_URL=/_/backend/api
REACT_APP_PAYSTACK_PUBLIC_KEY=pk_test_FILL_IN_YOUR_PAYSTACK_PUBLIC_KEY
REACT_APP_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# ─── SHARE LINKS (client domain only — backend host never appears) ──
# Optional canonical origin override; defaults to window.location.origin.
