# ─── DATABASE ───────────────────────────────────────────────
DATABASE_URL=postgresql://username:password@host:5432/southswift

# ─── REDIS ──────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT ────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# ─── PAYSTACK ───────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_test_FILL_IN_YOUR_PAYSTACK_SECRET_KEY
PAYSTACK_PUBLIC_KEY=pk_test_FILL_IN_YOUR_PAYSTACK_PUBLIC_KEY

# ─── PAYMENT PROVIDER ──────────────────────────────────────
# 'manual'  = tenants pay SouthSwift's bank account directly and an admin
#             approves the transfer (used until Paystack production keys exist).
# 'paystack' = original Paystack-hosted checkout (requires PAYSTACK_SECRET_KEY).
PAYMENT_PROVIDER=manual

# SouthSwift receiving account shown to tenants for manual bank transfers.
SS_ACCOUNT_NAME=SouthSwift Ltd
SS_ACCOUNT_NUMBER=0123456789
SS_BANK_NAME=Example Bank

# A non-room-share listing is reserved (marked unavailable) the moment a tenant
# starts a manual transfer; if no proof is submitted within this many hours the
# reservation is auto-released so the apartment can be booked by someone else.
RESERVATION_TIMEOUT_HOURS=24

# ─── CLOUDINARY ─────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ─── SWIFTDOC (AI-Powered — Google Gemini) ─────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ─── DOJAH (Agent Identity Verification) ────────────────
# Get these from app.dojah.io → App Settings
# Free tier: 100 verifications/month
DOJAH_APP_ID=your_dojah_app_id
DOJAH_API_KEY=your_dojah_api_key

# ─── EMAIL (Yandex 360) ─────────────────────────────────────
# Used for welcome emails and notifications
EMAIL_USER=ceo@southswift.com.ng
EMAIL_PASS=your_yandex_email_password
EMAIL_HOST=smtp.yandex.com
EMAIL_PORT=465

# ─── SERVER ─────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

ADMIN_EMAIL=

# ─── SLACK (Feedback form) ────────────────────────────────
# Create a Slack app, add the Bot Token Scopes: chat:write (and
# chat:write.public if you want it to post to channels it isn't
# explicitly invited to). Invite the bot to the channel, then set:
# SLACK_BOT_TOKEN=xoxb-...
SLACK_FEEDBACK_CHANNEL=C0XXXXXXX  

SLACK_BOT_TOKEN=xoxb-
SLACK_APP_TOKEN=

# ─── AUTO-SHARE (Phase 2 — mocked until creds exist) ──────────
# Leave SHARE_LIVE unset/false and every provider logs + resolves mocked:true.
# Set SHARE_LIVE=true + fill provider creds to post for real — no code change.
SHARE_LIVE=false
SHARE_WEBHOOK_URL=
BACKEND_PUBLIC_URL=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TO=
X_BEARER_TOKEN=
FACEBOOK_PAGE_TOKEN=
FACEBOOK_PAGE_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=